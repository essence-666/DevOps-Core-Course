version: "{{ docker_compose_version }}"

services:
  {{ web_app_name }}:
    image: {{ docker_image }}:{{ docker_image_tag }}
    container_name: {{ web_app_name }}

    ports:
      - "{{ web_app_port }}:{{ web_app_internal_port }}"

    environment:
      APP_SECRET_KEY: "{{ web_app_secret_key }}"

    restart: unless-stopped

    networks:
      - app_network

networks:
  app_network:
    driver: bridge